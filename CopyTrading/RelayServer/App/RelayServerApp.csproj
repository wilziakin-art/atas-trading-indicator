<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CopyTradingRelay</AssemblyName>
    <RootNamespace>CopyTrading.RelayServer</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <Optimize>true</Optimize>
    <SelfContained>false</SelfContained>

    <Company>CopyTrading</Company>
    <Product>ATAS CopyTrading Relay v2</Product>
    <Description>Relay Server dual-canal — déployable sur VPS Linux/Windows</Description>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <!-- Voir relay.service pour le deploiement Linux systemd -->

  <ItemGroup>
    <!-- Partage le protocole et le relay avec le projet principal -->
    <Compile Include="..\RelayServer.cs" />
    <Compile Include="..\..\Protocol\TradingMessage.cs" />
    <Compile Include="..\..\Protocol\CommMessage.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="relay.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="relay.service">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
